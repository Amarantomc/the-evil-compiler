use crate::nodes::{
    binaryop_node::{BinaryOp, BinaryOpNode},
    block_node::BlockNode,
    destassing_node::DestAssignNode,
    for_node::ForNode,
    funcall_node::FunCallNode,
    function_decl_node::FunctionDecl,
    if_node::IfNode,
    instantiation_node::InstantiationNode,
    let_node::LetNode,
    literal_node::{Literal, LiteralNode},
    member_access_node::{MemberAccessNode, MethodCallNode},
    program_node::{Program, Statement},
    type_decl_node::{TypeDeclNode, AttributeNode, TypeBodyItem, InheritanceClause},
    expr_node::{Expr, HulkType},
    unaryop_node::{UnaryOp, UnaryOpNode},
    while_node::WhileNode,
    type_test_node::TypeTestNode,
    type_downcast_node::TypeDowncastNode,
    tuple_node::{TupleNode, TupleAccessNode},
};
use crate::lexer::lexer::{Lexer,LexicalError};
use crate::lexer::token::Token;
grammar;

pub Program: Program = {
    <stmts:Statement+> => Program::new(stmts),
};

Statement: Statement = {
    <FunctionDecl> => Statement::FunctionDecl(<>),
    <TypeDecl> => Statement::TypeDecl(<>),
    <expr:TopExpr> => Statement::Expression(expr),
};

 
TopExpr: Expr = {
    <e:OrExpr>       ";"     => e,
    <e:OrExprOpenS>  ";"     => e,
    <e:OrExprOpenB>  (";")?  => e,
    <e:BlockExpr>    (";")?  => e,
};

FunctionDecl: FunctionDecl = {
    "function" <name:Ident> <g:GenericParams?> "(" <params:Comma<Param>> ")"
        <ty:TypeAnnotation?> "=>" <body:ExprRule> ";" => {
        FunctionDecl::new(name, g.unwrap_or_default(), params, body, ty.unwrap_or(HulkType::Unknown))
    },
    "function" <name:Ident> <g:GenericParams?> "(" <params:Comma<Param>> ")"
        <ty:TypeAnnotation?> <body:BlockExpr> (";")? => {
        FunctionDecl::new(name, g.unwrap_or_default(), params, body, ty.unwrap_or(HulkType::Unknown))
    },
};

MethodDecl: FunctionDecl = {
    <name:Ident> "(" <params:Comma<Param>> ")" <ty:TypeAnnotation?> "=>" <body:ExprRule> ";" => {
        FunctionDecl::new(name, vec![], params, body, ty.unwrap_or(HulkType::Unknown))
    },
    <name:Ident> "(" <params:Comma<Param>> ")" <ty:TypeAnnotation?> <body:BlockExpr> (";")? => {
        FunctionDecl::new(name, vec![], params, body, ty.unwrap_or(HulkType::Unknown))
    },
};

TypeDecl: TypeDeclNode = {
    "type" <name:Ident> <g:GenericParams?>  <params:("(" <Comma<Param>> ")")?>
        <inheritance:InheritanceClause?> "{" <body:TypeBodyItem*> "}" => {
        let mut attributes = Vec::new();
        let mut methods = Vec::new();
        for item in body {
            match item {
                TypeBodyItem::Assignment(a)   => attributes.push(a),
                TypeBodyItem::FunctionDecl(m) => methods.push(m),
            }
        }
        TypeDeclNode::with_inheritance(
            name, params.unwrap_or(vec![]),
            attributes, methods, inheritance, g.unwrap_or(vec![]))
    }
    
};

InheritanceClause: InheritanceClause = {
    "inherits" <parent:Ident> => InheritanceClause::new(parent, None),
    "inherits" <parent:Ident> "(" <args:Comma<SimpleExpr>> ")" => {
        InheritanceClause::new(parent, Some(args))
    },
};

TypeBodyItem: TypeBodyItem = {
    <id:VarIdent> <ty:TypeAnnotation?> "=" <expr:SimpleExpr> ";" => {
        TypeBodyItem::Assignment(AttributeNode::new(id, ty.unwrap_or(HulkType::Unknown), expr))
    },
    <MethodDecl> => TypeBodyItem::FunctionDecl(<>),
};

Param: (LiteralNode, HulkType) = {
    <id:VarIdent> <ty:TypeAnnotation?> => (id, ty.unwrap_or(HulkType::Unknown))
};

TypeAnnotation: HulkType = {
    ":" <Type> => <>
};

Type: HulkType = {
    "Number"  => HulkType::Number,
    "String"  => HulkType::String,
    "Boolean" => HulkType::Bool,
    <id:Ident> "<" <args:Comma1<Type>> ">" =>
        HulkType::Generic(id.value.as_id(), args),
    <id:Ident> => HulkType::Class(id.value.as_id()),
    "(" <t1:Type> "," <rest:Comma1<Type>> ")" => {
        let mut elems = vec![t1];
        elems.extend(rest);
        HulkType::Tuple(elems)
    },
};

Comma<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => { v.push(e); v }
    }
};

Comma1<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T> => { v.push(e); v }
};

GenericParams: Vec<String> = {
    "<" <ids:Comma1<Ident>> ">" => ids.into_iter().map(|i| i.value.as_id()).collect(),
};

TurboArgs: Vec<HulkType> = {
    "::" "<" <args:Comma1<Type>> ">" => args,
};

pub ExprRule: Expr = {
    SimpleExpr,
    BlockExpr,
};

 
SimpleExpr: Expr = {
    OrExpr,
    OrExprOpenS,
    OrExprOpenB,
};

BlockExpr: Expr = {
    "{" <exprs:(BlockItem)*> "}" => {
        Expr::Block(BlockNode::new(exprs))
    }
};

BlockItem: Expr = {
    <e:OrExpr>       ";"     => e,
    <e:OrExprOpenS>  ";"     => e,
    <e:OrExprOpenB>  (";")?  => e,
    <e:BlockExpr>    (";")?  => e,
};

Elif: (Expr, Expr) = {
    "elif" "(" <cond:OrExpr> ")" <body:ExprRule> => (cond, body),
};

 
BodyB: Expr = { BlockExpr, OrExprOpenB };
BodyS: Expr = { OrExpr,    OrExprOpenS };

OpenExprB: Expr = {
    "let" <assignments:Comma<Assignment>> "in" <body:BodyB> =>
        Expr::Let(LetNode::new(assignments, body)),
    "if" "(" <cond:OrExpr> ")" <tb:ExprRule> <eb:Elif*> "else" <fb:BodyB> =>
        Expr::If(IfNode::new(cond, tb, eb, fb)),
    "while" "(" <cond:OrExpr> ")" <body:BodyB> =>
        Expr::While(WhileNode::new(cond, body)),
    "for" "(" <var:VarIdent> "in" <iter:OrExpr> ")" <body:BodyB> =>
        Expr::For(ForNode::new(var, iter, body)),
};

OpenExprS: Expr = {
    "let" <assignments:Comma<Assignment>> "in" <body:BodyS> =>
        Expr::Let(LetNode::new(assignments, body)),
    "if" "(" <cond:OrExpr> ")" <tb:ExprRule> <eb:Elif*> "else" <fb:BodyS> =>
        Expr::If(IfNode::new(cond, tb, eb, fb)),
    "while" "(" <cond:OrExpr> ")" <body:BodyS> =>
        Expr::While(WhileNode::new(cond, body)),
    "for" "(" <var:VarIdent> "in" <iter:OrExpr> ")" <body:BodyS> =>
        Expr::For(ForNode::new(var, iter, body)),
};

Assignment: ((LiteralNode, HulkType), Expr) = {
    <id:VarIdent> <ty:TypeAnnotation?> "=" <expr:SimpleExpr> => ((id, ty.unwrap_or(HulkType::Unknown)), expr),
};

pub ConcExpr: Expr = {
    <l:ConcExpr> <op:ConcOpcode> <r:IsExpr> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    IsExpr,
};

ConcOpcode: BinaryOp = {
    "@"  => BinaryOp::SingleConc,
    "@@" => BinaryOp::SpacedConc,
};

pub OrExpr: Expr = {
    <l:OrExpr> <op:OrOpcode> <r:AndExpr> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    AndExpr,
};

OrOpcode: BinaryOp = {
    "|"  => BinaryOp::Or,
    "||" => BinaryOp::Or,
};

pub AndExpr: Expr = {
    <l:AndExpr> <op:AndOpcode> <r:AssignExpr> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    AssignExpr,
};

AndOpcode: BinaryOp = {
    "&"  => BinaryOp::And,
    "&&" => BinaryOp::And,
};

AssignExpr: Expr = {
    <id:Term> ":=" <expr:AssignExpr> => Expr::DestAssign(DestAssignNode::new(id, expr)),
    CompExpr,
};

pub CompExpr: Expr = {
    <l:CompExpr> <op:CompOpcode> <r:ConcExpr> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    ConcExpr,
};

CompOpcode: BinaryOp = {
    "==" => BinaryOp::Equal,
    "!=" => BinaryOp::Dist,
    ">=" => BinaryOp::Gequa,
    "<=" => BinaryOp::Lequa,
    ">"  => BinaryOp::Great,
    "<"  => BinaryOp::Less,
};

pub IsExpr: Expr = {
    <l:IsExpr> "is" <r:Ident> => Expr::TypeTest(TypeTestNode::new(l, r)),
    AsExpr,
};

pub AsExpr: Expr = {
    <l:AsExpr> "as" <r:Ident> => Expr::TypeDowncast(TypeDowncastNode::new(l, r)),
    ArithExpr,
};

pub ArithExpr: Expr = {
    <l:ArithExpr> <op:ArithOpCode> <r:FactAnd> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    FactAnd,
};

ArithOpCode: BinaryOp = {
    "+" => BinaryOp::Add,
    "-" => BinaryOp::Sub,
};

FactAnd: Expr = {
    <l:FactAnd> <op:FactAndOp> <r:UnaryExpr> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    UnaryExpr,
};

FactAndOp: BinaryOp = {
    "*" => BinaryOp::Mul,
    "/" => BinaryOp::Div,
    "%" => BinaryOp::Mod,
};

UnaryExpr: Expr = {
    <op:UnaryOpCode> <expr:Base> => Expr::Unary(UnaryOpNode::new(op, expr)),
    Base,
};

UnaryOpCode: UnaryOp = {
    "+" => UnaryOp::Plus,
    "-" => UnaryOp::Neg,
    "!" => UnaryOp::Not,
};

Base: Expr = {
    <l:Base> <op:PowOpcode> <r:Term> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    Term,
};

PowOpcode: BinaryOp = {
    "^" => BinaryOp::Pow
};

Term: Expr = {
   <l:@L> <n:Num> <r:@R> => Expr::Literal(LiteralNode::new_spanned(Literal::Number(n), (l, r))),
    <l:@L> "true"  <r:@R> => Expr::Literal(LiteralNode::new_spanned(Literal::Bool(true), (l, r))),
    <l:@L> "false" <r:@R> => Expr::Literal(LiteralNode::new_spanned(Literal::Bool(false), (l, r))),
    <l:@L> <s:StringLit> <r:@R> => Expr::Literal(LiteralNode::new_spanned(Literal::Str(s), (l, r))),

    "new" <id:Ident> <ta:TurboArgs?> "(" <args:Comma<SimpleExpr>> ")" => {
    let node = match ta {
        Some(targs) => FunCallNode::with_type_args(id, targs, args),
        None        => FunCallNode::new(id, args),
    };
    Expr::Instantiation(node)
},
    <inst:Term> "." <idx:TupleIndex> => {
        Expr::TupleAccess(TupleAccessNode::new(inst, idx))
    },
    <inst:Term> "." <call:FunCall> => {
        Expr::MethodCall(MethodCallNode::new(inst, call))
    },
    <inst:Term> "." <member:VarIdent> => {
        Expr::MemberAccess(MemberAccessNode::new(inst, member))
    },
    <FunCall> => Expr::FunCall(<>),

    "(" <e1:SimpleExpr> "," <rest:Comma1<SimpleExpr>> ")" => {
        let mut elems = vec![e1];
        elems.extend(rest);
        Expr::Tuple(TupleNode::new(elems))
    },
    "(" <ExprRule> ")",
    "base" "(" <args:Comma<SimpleExpr>> ")" => Expr::BaseCall(args),
    "self" => Expr::SelfRef,
    <id:VarIdent> => Expr::Literal(id),
     
};

 
OrExprOpenB: Expr = {
    <l:OrExpr> <op:OrOpcode> <r:AndExprOpenB> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    AndExprOpenB,
};
AndExprOpenB: Expr = {
    <l:AndExpr> <op:AndOpcode> <r:AssignExprOpenB> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    AssignExprOpenB,
};
AssignExprOpenB: Expr = {
    <id:Term> ":=" <expr:AssignExprOpenB> => Expr::DestAssign(DestAssignNode::new(id, expr)),
    CompExprOpenB,
};
CompExprOpenB: Expr = {
    <l:CompExpr> <op:CompOpcode> <r:ConcExprOpenB> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    ConcExprOpenB,
};
ConcExprOpenB: Expr = {
    <l:ConcExpr> <op:ConcOpcode> <r:IsExprOpenB> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    IsExprOpenB,
};
IsExprOpenB: Expr = { AsExprOpenB };
AsExprOpenB: Expr = { ArithExprOpenB };
ArithExprOpenB: Expr = {
    <l:ArithExpr> <op:ArithOpCode> <r:FactAndOpenB> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    FactAndOpenB,
};
FactAndOpenB: Expr = {
    <l:FactAnd> <op:FactAndOp> <r:UnaryExprOpenB> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    UnaryExprOpenB,
};
UnaryExprOpenB: Expr = {
    <op:UnaryOpCode> <expr:BaseOpenB> => Expr::Unary(UnaryOpNode::new(op, expr)),
    BaseOpenB,
};
BaseOpenB: Expr = {
    <l:Base> <op:PowOpcode> <r:TermOpenB> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    TermOpenB,
};
TermOpenB: Expr = { OpenExprB };

OrExprOpenS: Expr = {
    <l:OrExpr> <op:OrOpcode> <r:AndExprOpenS> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    AndExprOpenS,
};
AndExprOpenS: Expr = {
    <l:AndExpr> <op:AndOpcode> <r:AssignExprOpenS> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    AssignExprOpenS,
};
AssignExprOpenS: Expr = {
    <id:Term> ":=" <expr:AssignExprOpenS> => Expr::DestAssign(DestAssignNode::new(id, expr)),
    CompExprOpenS,
};
CompExprOpenS: Expr = {
    <l:CompExpr> <op:CompOpcode> <r:ConcExprOpenS> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    ConcExprOpenS,
};
ConcExprOpenS: Expr = {
    <l:ConcExpr> <op:ConcOpcode> <r:IsExprOpenS> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    IsExprOpenS,
};
IsExprOpenS: Expr = { AsExprOpenS };
AsExprOpenS: Expr = { ArithExprOpenS };
ArithExprOpenS: Expr = {
    <l:ArithExpr> <op:ArithOpCode> <r:FactAndOpenS> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    FactAndOpenS,
};
FactAndOpenS: Expr = {
    <l:FactAnd> <op:FactAndOp> <r:UnaryExprOpenS> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    UnaryExprOpenS,
};
UnaryExprOpenS: Expr = {
    <op:UnaryOpCode> <expr:BaseOpenS> => Expr::Unary(UnaryOpNode::new(op, expr)),
    BaseOpenS,
};
BaseOpenS: Expr = {
    <l:Base> <op:PowOpcode> <r:TermOpenS> => Expr::Binary(BinaryOpNode::new(l, op, r)),
    TermOpenS,
};
TermOpenS: Expr = { OpenExprS };

FunCall: FunCallNode = {
    <id:Ident> <ta:TurboArgs?> "(" <args:Comma<SimpleExpr>> ")" => {
        match ta {
            Some(targs) => FunCallNode::with_type_args(id, targs, args),
            None        => FunCallNode::new(id, args),
        }
    },
};

TupleIndex: usize = { <n:"int"> => n };

Float: f32 = { <f:"float"> => f };

Num: f32 = {
    <i:TupleIndex> => i as f32,
    <f:Float> => f,
};

StringLit: String = { <s:"string"> => s };

Ident: LiteralNode = { <l:@L> <s:"ident"> <r:@R> => LiteralNode::new_spanned(Literal::Id(s), (l, r)) };

VarIdent: LiteralNode = {
    <Ident>,
    <l:@L> "base" <r:@R> => LiteralNode::new_spanned(Literal::Id("base".to_string()), (l, r)),
};

extern {
    type Location = usize;
    type Error = LexicalError;

    enum Token {
        // literales con payload
        "ident"  => Token::Ident(<String>),
        "int"    => Token::Int(<usize>),
        "float"  => Token::Float(<f32>),
        "string" => Token::Str(<String>),

         
        "if" => Token::If, "elif" => Token::Elif, "else" => Token::Else,
        "while" => Token::While, "for" => Token::For, "in" => Token::In,
        "let" => Token::Let, "type" => Token::Type,
        "function" => Token::Function, "inherits" => Token::Inherits,
        "new" => Token::New, "base" => Token::Base, "self" => Token::SelfKw,
        "true" => Token::True, "false" => Token::False,
        "is" => Token::Is, "as" => Token::As,
        "Number" => Token::KwNumber, "String" => Token::KwString, "Boolean" => Token::KwBoolean,

        // operadores y puntuación
        "@@" => Token::AtAt, "@" => Token::At,
        "::" => Token::ColonColon, ":=" => Token::Assign, ":" => Token::Colon,
        "=>" => Token::FatArrow, "==" => Token::EqEq, "=" => Token::Eq,
        "!=" => Token::Ne, "!" => Token::Bang,
        "<=" => Token::Le, "<" => Token::Lt, ">=" => Token::Ge, ">" => Token::Gt,
        "&&" => Token::AndAnd, "&" => Token::Amp, "||" => Token::OrOr, "|" => Token::Pipe,
        "+" => Token::Plus, "-" => Token::Minus, "*" => Token::Star,
        "/" => Token::Slash, "%" => Token::Percent, "^" => Token::Caret,
        "(" => Token::LParen, ")" => Token::RParen, "{" => Token::LBrace, "}" => Token::RBrace,
        "," => Token::Comma, ";" => Token::Semi, "." => Token::Dot,
    }
}
