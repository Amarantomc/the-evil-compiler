use std::str::FromStr;
use crate::nodes::{
    binaryop_node::{BinaryOp, BinaryOpNode},
    block_node::BlockNode,
    destassing_node::DestAssignNode,
    for_node::ForNode,
    funcall_node::FunCallNode,
    function_decl_node::FunctionDecl,
    if_node::IfNode,
    instantiation_node::InstantiationNode,
    let_node::LetNode,
    literal_node::{Literal, LiteralNode},
    member_access_node::{MemberAccessNode, MethodCallNode},
    program_node::{Program, Statement},
    type_decl_node::{TypeDeclNode, AttributeNode, TypeBodyItem, InheritanceClause},
    expr_node::{Expr, HulkType},
    unaryop_node::{UnaryOp, UnaryOpNode},
    while_node::WhileNode,
    type_test_node::TypeTestNode,
    type_downcast_node::TypeDowncastNode
};

grammar;

pub Program: Program = {
    <stmts:Statement+> => Program::new(stmts),
};

Statement: Statement = {
    <FunctionDecl> => Statement::FunctionDecl(<>),
    <TypeDecl> => Statement::TypeDecl(<>),
    <expr:TopExpr> => Statement::Expression(expr),
};

// Top level: SimpleExpr requiere ; u BlockExpr tiene ; opcional
TopExpr: Expr = {
    <e:SimpleExpr> ";" => e,
    <e:BlockExpr> (";")?  => e
};

FunctionDecl: FunctionDecl = {
    "function" <name:Ident> "(" <params:Comma<Param>> ")" <ty:TypeAnnotation?> "=>" <body:ExprRule> ";" => {
        FunctionDecl::new(name, params, body, ty.unwrap_or(HulkType::Unknown))
    },
    "function" <name:Ident> "(" <params:Comma<Param>> ")" <ty:TypeAnnotation?> <body:BlockExpr> (";")?  => {
        FunctionDecl::new(name, params, body, ty.unwrap_or(HulkType::Unknown))
    },
};

MethodDecl: FunctionDecl = {
    <name:Ident> "(" <params:Comma<Param>> ")" <ty:TypeAnnotation?> "=>" <body:ExprRule> ";" => {
        FunctionDecl::new(name, params, body, ty.unwrap_or(HulkType::Unknown))
    },
    <name:Ident> "(" <params:Comma<Param>> ")" <ty:TypeAnnotation?> <body:BlockExpr> (";")?  => {
        FunctionDecl::new(name, params, body, ty.unwrap_or(HulkType::Unknown))
    },
};

TypeDecl: TypeDeclNode = {
    "type" <name:Ident> <params:("(" <Comma<Param>> ")")?> <inheritance:InheritanceClause?> "{" <body:TypeBodyItem*> "}" => {
        let mut attributes = Vec::new();
        let mut methods = Vec::new();
        for item in body {
            match item {
                TypeBodyItem::Assignment(a) => attributes.push(a),
                TypeBodyItem::FunctionDecl(m) => methods.push(m),
            }
        }
        TypeDeclNode::with_inheritance(name, params.unwrap_or(vec![]),attributes, methods,inheritance)
    }
};

InheritanceClause: InheritanceClause = {
    "inherits" <parent:Ident> => InheritanceClause::new(parent, None),
    "inherits" <parent:Ident> "(" <args:Comma<SimpleExpr>> ")" => {
        InheritanceClause::new(parent, Some(args))
    },
};

TypeBodyItem: TypeBodyItem = {
    <id:Ident> <ty:TypeAnnotation?> "=" <expr:ConcExpr> ";" => {
        TypeBodyItem::Assignment(AttributeNode::new(id, ty.unwrap_or(HulkType::Unknown), expr))
    },
    <MethodDecl> => TypeBodyItem::FunctionDecl(<>),
};
 

 

Param: (LiteralNode, HulkType) = {
    <id:Ident> <ty:TypeAnnotation?> => (id, ty.unwrap_or(HulkType::Unknown))
};

TypeAnnotation: HulkType = {
    ":" <Type> => <>
};

Type: HulkType = {
    "Number" => HulkType::Number,
    "String" => HulkType::String,
    "Boolean" => HulkType::Bool,
    <id:Ident> =>  HulkType::Class(id.value.as_id())
};


Comma<T>: Vec<T> = { 
    <mut v:(<T> ",")*> <e:T?> => match e { 
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
};

// Expresión pura (sin ; manejo): usado dentro de Let, If, While, For
pub ExprRule: Expr = {
    SimpleExpr,
    BlockExpr,
};

// Expresiones simples que requieren ; en top level (pero el ; se agrega en TopExpr)
SimpleExpr: Expr = {
    LetExpr,
    IfExpr,
    WhileExpr,
    ForExpr,
    ConcExpr,
};

// Bloques que tienen ; opcional en top level
BlockExpr: Expr = {
    "{" <exprs:(BlockItem)*> "}"  => {
        Expr::Block(BlockNode::new(exprs))
    }
};

// Items dentro de un bloque: pueden ser simples (con ;) o bloques (con ; opcional)
BlockItem: Expr = {
    <e:SimpleExpr> ";" => e,
    <e:BlockExpr> (";")?  => e
};

LetExpr: Expr = {
    "let" <assignments:Comma<Assignment>> "in" <body:ExprRule> => {
        Expr::Let(LetNode::new(assignments, body))
    },
};

IfExpr: Expr = {
    "if" "(" <cond:OrExpr> ")" <true_branch:ExprRule> <elif_branches:Elif*> "else" <false_branch:ExprRule> => {
        Expr::If(IfNode::new(cond, true_branch, elif_branches, false_branch))
    },
};

Elif: (Expr, Expr) = {
    "elif" "(" <cond:OrExpr> ")" <body:ExprRule> => (cond, body),
};

WhileExpr: Expr = {
    "while" "(" <cond:OrExpr> ")" <body:ExprRule> => {
        Expr::While(WhileNode::new(cond, body))
    },
};

ForExpr: Expr = {
    "for" "(" <var:Ident> "in" "range" "(" <iter1:OrExpr> "," <iter2:OrExpr> ")" ")" <body:ExprRule> => {
        let iter = Expr::FunCall(FunCallNode::new(LiteralNode::new(Literal::Id("range".to_string())), vec![iter1, iter2]));
        Expr::For(ForNode::new(var, iter, body))
    },
};

Assignment: ((LiteralNode, HulkType), Expr) = {
    <id:Ident> <ty:TypeAnnotation?> "=" <expr:ConcExpr> => ((id, ty.unwrap_or(HulkType::Unknown)), expr),
};

pub ConcExpr : Expr = {
    <l: ConcExpr> <op : ConcOpcode> <r: OrExpr> => {
        Expr::Binary(BinaryOpNode::new(l,op,r))
    },
    OrExpr,
};

ConcOpcode: BinaryOp = {
    "@" => BinaryOp::SingleConc,
    "@@" => BinaryOp::SpacedConc
};

pub OrExpr: Expr = { 
    <l:OrExpr> <op:OrOpcode> <r:AndExpr> => {
        Expr::Binary(BinaryOpNode::new(l, op, r))
    },
    AndExpr,
};

OrOpcode: BinaryOp = {
    "|" => BinaryOp::Or,
    "||" => BinaryOp::Or
};

pub AndExpr: Expr = {
    <l:AndExpr> <op:AndOpcode> <r:AssignExpr> => {
        Expr::Binary(BinaryOpNode::new(l, op, r))
    },
    AssignExpr,
};

AndOpcode: BinaryOp = {
    "&" => BinaryOp::And,
    "&&" => BinaryOp::And
};

AssignExpr: Expr = {
    <id:Term> ":=" <expr:AssignExpr> => {
        Expr::DestAssign(DestAssignNode::new(id, expr))
    },
    CompExpr,
};

pub CompExpr: Expr = {
    <l:CompExpr> <op:CompOpcode> <r:IsExpr> => {
        Expr::Binary(BinaryOpNode::new(l, op, r))
    },
    IsExpr,
};

CompOpcode: BinaryOp = { 
    "==" => BinaryOp::Equal,
    "!=" => BinaryOp::Dist,
    ">=" => BinaryOp::Gequa,
    "<=" => BinaryOp::Lequa,
    ">" => BinaryOp::Great,
    "<" => BinaryOp::Less
};

pub IsExpr: Expr = {
    <l:IsExpr> "is" <r:Ident> => {
        Expr::TypeTest(TypeTestNode::new(l,r))
    },
    AsExpr,
};

pub AsExpr: Expr = {
    <l:AsExpr> "as" <r:Ident> => {
        Expr::TypeDowncast(TypeDowncastNode::new(l,r))
    },
    ArithExpr,
};

pub ArithExpr: Expr = {
    <l:ArithExpr> <op:ArithOpCode> <r:FactAnd> => {
        Expr::Binary(BinaryOpNode::new(l, op, r))
    },
    FactAnd,
};

ArithOpCode: BinaryOp = { 
    "+" => BinaryOp::Add,
    "-" => BinaryOp::Sub,
};

FactAnd: Expr = {
    <l:FactAnd> <op:FactAndOp> <r:UnaryExpr> => {
        Expr::Binary(BinaryOpNode::new(l, op, r))
    },
    UnaryExpr,
};

FactAndOp: BinaryOp = {
    "*" => BinaryOp::Mul,
    "/" => BinaryOp::Div,
    "%" => BinaryOp::Mod,
};

UnaryExpr: Expr = {
    <op:UnaryOpCode> <expr:Base> => {
        Expr::Unary(UnaryOpNode::new(op, expr))
    },
    Base,
};

UnaryOpCode: UnaryOp = {
    "+" => UnaryOp::Plus,
    "-" => UnaryOp::Neg,
    "!" => UnaryOp::Not,
};

Base: Expr = {
    <l:Base> <op:PowOpcode> <r:Term> => {
        Expr::Binary(BinaryOpNode::new(l, op, r))
    },
    Term,
};

PowOpcode: BinaryOp = {
    "^" => BinaryOp::Pow
};

Term: Expr = {
    Num => Expr::Literal(LiteralNode::new(Literal::Number(<>))),
    "true" => Expr::Literal(LiteralNode::new(Literal::Bool(true))),
    "false" => Expr::Literal(LiteralNode::new(Literal::Bool(false))),
    StringLit => Expr::Literal(LiteralNode::new(Literal::Str(<>))),
    "new" <id:Ident> "(" <args:Comma<SimpleExpr>> ")" => {
        Expr::Instantiation(FunCallNode::new(id, args))
    },
    <inst:Term> "." <call:FunCall> => {
        Expr::MethodCall(MethodCallNode::new(inst, call))
    },
    <inst:Term> "." <member:Ident> => {
        Expr::MemberAccess(MemberAccessNode::new(inst, member))
    },
    <FunCall> => Expr::FunCall(<>),
    "(" <ExprRule> ")" ,
    "base" "(" <args:Comma<SimpleExpr>> ")" => Expr::BaseCall(args),
    "self" => Expr::SelfRef,
    <id: Ident> => Expr::Literal(id)
};

FunCall: FunCallNode = {
    <id:Ident> "(" <args:Comma<SimpleExpr>> ")" => {
        FunCallNode::new(id, args)
    },
};

Num: f32 = {
    r"[0-9]+(\.[0-9]+)?" => f32::from_str(<>).unwrap()
};

StringLit: String = {
    r#""[^"]*""# => <>.trim_matches('"').to_string()
};

Ident: LiteralNode = {
    r"[a-zA-Z_][a-zA-Z0-9_]*" => LiteralNode::new(Literal::Id(<>.to_string())),
};
